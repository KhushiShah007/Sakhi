# --- core ---
NODE_ENV=development
PORT=8787
PUBLIC_URL=http://localhost:5173
DATABASE_URL=                  # empty = embedded PGlite (dev only). Required in production.
PGLITE_DIR=                    # optional folder to persist PGlite data in dev
SAKHI_DATA_KEY=                # 32 bytes base64: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`. Required in production.
RATE_LIMIT_PER_MIN=120
DEMO_MODE=false                # shows a small DEMO badge
DEMO_AUTH=false                # fixed OTP 123456. Server REFUSES TO START if true with NODE_ENV=production.
HELPLINES_JSON=                # e.g. [{"name":"Emergency","number":"112"},{"name":"Tele-MANAS","number":"14416"}]
# --- OTP (any SMS gateway behind a webhook that receives {phone, code}) ---
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
# --- LLM (optional; rule-based fallback when empty) ---
ANTHROPIC_API_KEY=
SAKHI_MODEL_CHAT=claude-sonnet-5-5
SAKHI_MODEL_EXTRACT=claude-haiku-5-5
# --- WhatsApp Cloud API (optional; family link page is the fallback) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_CARD=sakhi_signal_card   # approved template: 1 body variable + 2 quick-reply buttons (Done / Need help understanding)
WHATSAPP_APP_SECRET=                       # verifies X-Hub-Signature-256 on the webhook
WHATSAPP_VERIFY_TOKEN=                     # for the GET subscription handshake
# --- Natural voice (optional). Without a key the app speaks with the browser voice ---
ELEVENLABS_API_KEY=            # server-side only; never commit it. Put it in .env (gitignored)
ELEVENLABS_VOICE_ID=           # default: a stock premade calm voice. Use premade/licensed voices only, never a clone of a real person
ELEVENLABS_MODEL=eleven_multilingual_v2   # check the model supports your languages (Hindi yes; verify Marathi/Gujarati for your model)
