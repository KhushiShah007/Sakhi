{
  "name": "sakhi-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "screenshots": "vite build && node scripts/screenshots.mjs",
    "record": "vite build && node scripts/record.mjs",
    "test": "vitest run",
    "test:safety": "vitest run server/test/safety.suite.test.ts",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "api": "tsx server/src/index.ts",
    "e2e:live": "node scripts/e2e-onboarding.mjs && node scripts/e2e-vent.mjs && node scripts/e2e-home.mjs && node scripts/e2e-checkin.mjs && node scripts/e2e-translator.mjs && node scripts/e2e-privacy.mjs && node scripts/e2e-brief.mjs && node scripts/e2e-family.mjs",
    "build:web": "vite build",
    "start": "tsx server/src/index.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@fontsource/kalam": "^5.1.0",
    "@fontsource/noto-sans-devanagari": "^5.1.0",
    "@fontsource/noto-sans-gujarati": "^5.1.0",
    "@fontsource/poppins": "^5.1.0",
    "fastify": "^5.12.7",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.48.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
